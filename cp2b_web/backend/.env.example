# Database
DATABASE_URL=postgres://cp2b:cp2b@localhost:5432/cp2b

# Server
PORT=3001
# Na VM: production. Sem ADMIN_PASSWORD, o painel fica trancado em vez de aberto.
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Quem repassa o IP do visitante (X-Forwarded-For), separado por vírgula.
# Na VM: loopback (o Apache) + o IP do proxy da Unicamp que termina o TLS.
# Sem o proxy na lista, os limites por IP valem para o site inteiro de uma vez.
# Ver src/middleware/trustProxy.js.
TRUST_PROXY=loopback

# Admin Authentication (set password in production)
ADMIN_PASSWORD=

# Email (SMTP) — Forum Paulista meetup notifications & newsletter
# Use a Google App Password (16 chars) — requires 2-Step Verification on the account
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=forucp2b@unicamp.br
SMTP_PASS=
SMTP_FROM=Forum Paulista CP2b <forucp2b@unicamp.br>

# Invite token — optional URL gate for /registro and /agenda-meetups
INVITE_TOKEN=
